CONFIG_IDF_TARGET="esp32s3"

# 16 MB quad NOR, 80 MHz. Not octal flash.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 8 MB in-package octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_FREERTOS_HZ=1000

# Native USB on GPIO19/20. This board has no UART bridge.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Chip is 240 MHz. The old name CONFIG_ESP_DEFAULT_CPU_FREQ_240 is not a Kconfig symbol.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Bluetooth off. Wi-Fi stays off until cortex mode.
# CONFIG_BT_ENABLED is not set
# CONFIG_ESP_WIFI_ENABLED is not set
